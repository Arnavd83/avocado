# Inference Server - Environment Variables
# Copy to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# EXISTING PROJECT VARIABLES (from root .env)
# =============================================================================
# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# OpenAI Configuration (using OpenRouter)
OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI Configuration (used by inspect model strings like openai/azure/<deployment>)
# Example base URL format: https://<your-resource-name>.openai.azure.com
# Keep these set even when using PETRI_<ROLE>_* overrides (they act as global defaults/bootstrap).
AZUREAI_OPENAI_API_KEY=your_azure_openai_api_key_here
AZUREAI_OPENAI_BASE_URL=https://your-resource-name.openai.azure.com
# Optional (inspect default is 2025-03-01-preview)
AZUREAI_OPENAI_API_VERSION=2025-03-01-preview

# Azure Anthropic Configuration (used by inspect model strings like anthropic/azure/<model-or-deployment>)
# Example base URL format: https://<resource>.services.ai.azure.com/anthropic
AZUREAI_ANTHROPIC_API_KEY=your_azure_anthropic_api_key_here
AZUREAI_ANTHROPIC_BASE_URL=https://your-resource-name.services.ai.azure.com/anthropic

# OpenRouter App Identification
OPENROUTER_APP_NAME=avocado

# Tinker API key for finetuning
TINKER_API_KEY=your_tinker_api_key_here

# Lambda AI API KEY
LAMBDA_API_KEY=your_lambda_api_key_here

# HuggingFace API KEY
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# =============================================================================
# INFERENCE SERVER - Lambda Cloud Configuration
# =============================================================================
# Lambda SSH key name (must be registered in Lambda Cloud)
LAMBDA_SSH_KEY_NAME=your_ssh_key_name

# Path to your private SSH key (for connecting to instances)
SSH_PRIVATE_KEY_PATH=~/.ssh/lambda_key

# Lambda persistent filesystem name
LAMBDA_FILESYSTEM_NAME=your_filesystem_name

# =============================================================================
# INFERENCE SERVER - Tailscale
# =============================================================================
# Tailscale auth key for joining the tailnet
# Generate at: https://login.tailscale.com/admin/settings/keys
# Recommended: use a reusable, ephemeral key
TS_AUTHKEY=tskey-auth-xxxxx

# =============================================================================
# INFERENCE SERVER - vLLM API Key
# =============================================================================
# Shared API key for vLLM endpoints - pick any string your team agrees on
# All researchers use the same key
VLLM_API_KEY=research-team-shared-key

# =============================================================================
# VALUE MEASUREMENT - SQLite (emergent values / compute-utilities)
# =============================================================================
# Local path (repo-relative or absolute). Created automatically on first run.
VALUE_MEASUREMENT_DB_PATH=data/value_measurement.db

# =============================================================================
# DURABILITY - Shared Database
# =============================================================================
# Path to the shared SQLite database on Google Drive (or other shared storage)
PETRI_DB_PATH=/path/to/shared/drive/petri_runs.db

# Optional: role-specific model credentials/endpoints.
# Use these when auditor/judge/target need different providers or different endpoints.
# If unset, normal provider env vars are used.
#
# OpenAI-on-Azure role overrides:
# PETRI_AUDITOR_BASE_URL=https://your-auditor-resource.openai.azure.com
# PETRI_AUDITOR_API_KEY=your_auditor_key
# PETRI_AUDITOR_API_VERSION=2025-03-01-preview
#
# Anthropic-on-Azure role overrides:
# PETRI_AUDITOR_BASE_URL=https://your-auditor-resource.services.ai.azure.com/anthropic
# PETRI_AUDITOR_API_KEY=your_auditor_key
#
# Judge role overrides:
# PETRI_JUDGE_BASE_URL=https://your-judge-resource.services.ai.azure.com/anthropic
# PETRI_JUDGE_API_KEY=your_judge_key
#
# Target role overrides:
# PETRI_TARGET_BASE_URL=https://your-target-resource.services.ai.azure.com/anthropic
# PETRI_TARGET_API_KEY=your_target_key

# Optional: override Petri judge fallback model (defaults to OpenRouter Claude 3.7 Sonnet).
# Examples:
# PETRI_JUDGE_FALLBACK_MODEL=openai/azure/your-fallback-deployment
# PETRI_JUDGE_FALLBACK_MODEL=anthropic/azure/claude-opus-4-6
# =============================================================================
# OPTIONAL - Overrides (uncomment to use)
# =============================================================================
# Override default model (must be defined in config/default.yaml)
# DEFAULT_MODEL=llama31-8b

# Override default GPU type
# DEFAULT_GPU=gpu_1x_a100

# Override idle shutdown timeout (minutes, 0 = disabled)
# IDLE_TIMEOUT=60

# Override health check timeout (seconds)
# HEALTH_CHECK_TIMEOUT=900
